    {
      "parameters": {
        "jsCode": "// 1. Ambil data dari node Google Sheets (input node ini)\nconst employeeData = items[0].json;\n\n// 2. Ambil data dari node Form Trigger\n// Pastikan nama node di dalam $('...') SAMA PERSIS dengan nama node Form Anda\nconst formData = $('On form submission').first().json;\n\n// 3. Proses tanggal menggunakan Luxon\nconst start = DateTime.fromISO(formData[\"Tanggal Mulai\"]);\nconst end = DateTime.fromISO(formData[\"Tanggal Selesai\"]);\n\n// Validasi tanggal\nif (!start.isValid || !end.isValid) {\n  return [{\n    json: {\n      error: \"Format tanggal tidak valid. Pastikan Tanggal Mulai dan Tanggal Selesai diisi dengan benar.\",\n      startRaw: formData[\"Tanggal Mulai\"],\n      endRaw: formData[\"Tanggal Selesai\"]\n    }\n  }];\n}\n\nif (end < start) {\n  return [{\n    json: {\n      error: \"Tanggal Selesai tidak boleh lebih awal dari Tanggal Mulai.\",\n      start: formData[\"Tanggal Mulai\"],\n      end: formData[\"Tanggal Selesai\"]\n    }\n  }];\n}\n\n// Hitung durasi (selisih hari + 1 agar inklusif)\nconst durationInDays = end.diff(start, 'days').days + 1;\n\n// 4. Logika validasi saldo\nconst currentBalance = parseInt(employeeData[\"Saldo_Cuti\"]);\nconst hasEnoughBalance = currentBalance >= durationInDays;\n\n// Generate ID unik\nconst uniqueId = 'REQ-' + Date.now();\n\n// 5. Return data gabungan\nreturn [\n  {\n    json: {\n      ...employeeData,\n      ...formData,\n      durationRequested: durationInDays,\n      currentBalance: currentBalance,\n      isApprovedSystem: hasEnoughBalance,\n      message: hasEnoughBalance ? \"Saldo Cukup\" : \"Saldo Tidak Cukup\",\n      requestId: uniqueId\n    }\n  }\n];"
      },
