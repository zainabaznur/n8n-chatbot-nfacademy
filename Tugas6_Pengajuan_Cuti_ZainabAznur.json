    {
      "parameters": {
        "jsCode": "// 1. Ambil data dari Webhook (node paling awal)\n// Ambil 'days' (jumlah hari cuti) yang dikirim lewat URL\nconst webhookNode = $('Webhook').first();\nif (!webhookNode || !webhookNode.json || !webhookNode.json.query) {\n  return [{\n    json: {\n      error: \"Data Webhook tidak ditemukan. Pastikan node Webhook bernama 'Webhook' dan mengirim parameter query.\"\n    }\n  }];\n}\n\nconst webhookData = webhookNode.json.query;\nconst daysRequested = parseInt(webhookData.days);\n\nif (isNaN(daysRequested)) {\n  return [{\n    json: {\n      error: \"Parameter 'days' tidak valid atau tidak ditemukan di URL Webhook.\",\n      rawQuery: webhookData\n    }\n  }];\n}\n\n// 2. Ambil data dari Google Sheets (node sebelumnya: Cari Data Karyawan)\nconst currentData = items[0].json;\nconst currentBalance = parseInt(currentData.Saldo_Cuti);\n\nif (isNaN(currentBalance)) {\n  return [{\n    json: {\n      error: \"Field 'Saldo_Cuti' tidak ditemukan atau tidak valid di data karyawan.\",\n      rawData: currentData\n    }\n  }];\n}\n\n// 3. Hitung saldo baru\nconst newBalance = currentBalance - daysRequested;\n\n// 4. Return data untuk update\nreturn [{\n  json: {\n    ...currentData,\n    newBalance: newBalance\n  }\n}];"
      },
